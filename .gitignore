# ==============================================================================
# Hybrid Observability Platform
# Repository-wide ignore rules
# ==============================================================================


# ------------------------------------------------------------------------------
# Environment variables and secrets
# ------------------------------------------------------------------------------

.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

secrets/
credentials/
private/
local-secrets/

*credentials*
*secret*
*.secret

# Allow explicitly documented secret templates
!*.example
!**/*.example


# ------------------------------------------------------------------------------
# Terraform
# ------------------------------------------------------------------------------

**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

!*.tfvars.example
!*.tfvars.json.example

crash.log
crash.*.log

override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
*.plan
tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# Keep Terraform dependency lock files versioned
!.terraform.lock.hcl


# ------------------------------------------------------------------------------
# AWS
# ------------------------------------------------------------------------------

.aws/
aws-credentials*
aws-config.local
cdk.out/
.aws-sam/

# Local AWS CLI and integration outputs
aws-output/
aws-exports/
resource-inventory.local.*


# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so

.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
venv.bak/
env.bak/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

.coverage
.coverage.*
coverage.xml
htmlcov/
pytest-report.xml
test-results/

# Python logs and local databases
*.py.log
*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------------------------
# Docker and container runtime
# ------------------------------------------------------------------------------

docker-data/
container-data/
runtime-data/

docker-compose.override.yml
compose.override.yaml
compose.override.yml

*.container.log
*.docker.log

# Local container environment files
docker.env
docker.env.*
!docker.env.example


# ------------------------------------------------------------------------------
# Observability runtime data
# ------------------------------------------------------------------------------

data/
volumes/

prometheus-data/
loki-data/
tempo-data/
grafana-data/
otel-data/

**/prometheus/data/
**/loki/data/
**/tempo/data/
**/grafana/data/
**/otel-collector/data/

# Write-ahead logs and local telemetry storage
wal/
**/wal/
chunks/
**/chunks/
blocks/
**/blocks/
compactor/
**/compactor/

# Local provisioning generated at runtime
generated-provisioning/
rendered-config/
runtime-config/

# Telemetry exports and captures
telemetry-export/
telemetry-data/
trace-export/
log-export/
metric-export/

*.prom
*.otlp
*.otlp.json
*.trace.json

# Preserve versioned configuration and examples
!observability/**/config/
!observability/**/provisioning/
!observability/**/dashboards/


# ------------------------------------------------------------------------------
