k6-results/
load-test-results/
performance-results/

*.k6.json
*.k6.csv
summary.json
summary.html


# ------------------------------------------------------------------------------
# Logs, process files, and temporary outputs
# ------------------------------------------------------------------------------

*.log
logs/

*.pid
*.pid.lock
*.seed

tmp/
temp/
.cache/
.cache-loader/

*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~


# ------------------------------------------------------------------------------
# Security and analysis tools
# ------------------------------------------------------------------------------

checkov-report.*
tfsec-report.*
trivy-report.*
grype-report.*
syft-report.*
semgrep-report.*
bandit-report.*
gitleaks-report.*

.sarif/
*.sarif

# Preserve intentionally committed security policies
!SECURITY.md
!docs/security/**


# ------------------------------------------------------------------------------
# Visual Studio Code and development environments
# ------------------------------------------------------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
!.vscode/tasks.example.json
!.vscode/launch.example.json

.idea/
*.code-workspace

.devcontainer/local/


